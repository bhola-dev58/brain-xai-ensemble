# BrainTumorXAI — Environment Variables Reference
#
# Copy this file to `.env` and fill in the values for your environment.
# All variables have documented safe defaults shown below.
# NEVER commit your real .env file to version control.
#
# Usage (Linux/macOS):
#   cp .env.example .env
#   source .env   (or use `python-dotenv` / Docker --env-file)
#
# Usage (Docker):
#   docker run --env-file .env ...
#   docker compose up  (docker-compose.yml already reads .env automatically)

# ─── Server Runtime ───────────────────────────────────────────────────────────

# Host interface to bind the ASGI server.
# Use 0.0.0.0 for all interfaces (required for Docker/cloud).
HOST=0.0.0.0

# Port for the PACS Workstation & REST API.
# Render/Railway override this automatically via their PORT env var.
PORT=8000

# ─── API Security ─────────────────────────────────────────────────────────────

# Secret API key for authenticating protected endpoints:
#   POST /api/predict   POST /api/report   GET /api/history
#
# When set, all protected endpoints require:
#   Header: X-API-Key: <key>
#   OR Authorization: Bearer <key>
#
# Leave blank to run in open development mode (no authentication enforced).
BRAIN_XAI_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────

# Comma-delimited list of allowed CORS origins.
# Use '*' to allow all origins (not recommended for production).
# Default (blank) = restrict to localhost:8000 and 127.0.0.1:8000.
CORS_ALLOWED_ORIGINS=

# ─── Upload Limits ────────────────────────────────────────────────────────────

# Maximum allowed MRI scan upload size in megabytes.
# Increase for volumetric DICOM series with thick-slice stacks.
MAX_UPLOAD_SIZE_MB=25

# Maximum allowed image pixel dimension (width or height) in pixels.
# Protects against decompression bomb attacks.
MAX_IMAGE_DIMENSION=5000

# ─── Storage Paths ────────────────────────────────────────────────────────────

# Directory containing trained model weights (.keras / .h5).
# Default: <project_root>/models
# MODELS_DIR=/app/models

# Directory for the SQLite patient case history database.
# Default: <project_root>/data
# DATA_DIR=/app/data

# Full path to the SQLite database file.
# Default: <DATA_DIR>/patient_history.db
# DB_PATH=/app/data/patient_history.db

# Directory where generated PDF clinical reports are stored.
# Default: <project_root>/reports
# REPORTS_DIR=/app/reports

# Sub-directory for temporary report snapshot images (auto-cleaned after generation).
# Default: <REPORTS_DIR>/temp
# TEMP_REPORTS_DIR=/app/reports/temp

# ─── Logging & Observability ──────────────────────────────────────────────────

# Log verbosity level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── TensorFlow Tuning ────────────────────────────────────────────────────────

# Suppress TensorFlow C++ verbose logs (0=all, 1=no INFO, 2=no WARNING, 3=no ERROR)
TF_CPP_MIN_LOG_LEVEL=3

# Force CPU-only execution (remove or set to '' to enable GPU).
CUDA_VISIBLE_DEVICES=-1

# ─── API Documentation ────────────────────────────────────────────────────────

# Set to 'false' in production to disable /docs, /redoc, and /openapi.json.
ENABLE_API_DOCS=true
